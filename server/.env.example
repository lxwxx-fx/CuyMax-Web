# Copia este archivo a ".env" y completa los valores reales.
# El archivo ".env" NO se sube al repositorio (contiene secretos).

# Conexion a PostgreSQL (obligatorio)
DATABASE_URL=postgresql://postgres:TU_CONTRASENA@localhost:5432/cuyes

# Asistente de IA (opcional)
GROQ_API_KEY=
MODELO_IA=openai/gpt-oss-20b

# Clave para proteger la API en red (opcional; si se define, el panel la pide en Ajustes)
API_TOKEN=
